        \hline
        \textbf{Parameter} & \textbf{Figure 7} & \textbf{Figure A.9} & \textbf{Figure A.8} & \textbf{Figure A.7} \\
        \hline
        Aerosol 1 & Sea salt & Biogenic OC & Sea salt & Sea salt \\
        \hline
        Aerosol 2 & Sulfate & Anthropogenic OC & Black carbon & Biogenic OC \\
        \hline
        Maximum supersaturation (\%) & 0.56 & 0.42 & -- & 0.40 \\
        \hline
        Minimum dry radius to grow ($\mu$m) & 0.05 & 0.08 & 0.05 & 0.08 \\
        \hline
